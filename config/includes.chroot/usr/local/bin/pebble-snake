#!/usr/bin/env python3
"""
Pebble Snake – minimal classic Snake game using Tkinter.
Part of PebbleOS built-in games.
"""
import tkinter as tk
import random

CELL = 20
COLS, ROWS = 30, 20
WIDTH, HEIGHT = COLS * CELL, ROWS * CELL
SPEED = 120  # ms

class SnakeGame:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Pebble Snake")
        self.root.resizable(False, False)
        self.canvas = tk.Canvas(self.root, width=WIDTH, height=HEIGHT, bg="#1e1e2e", highlightthickness=0)
        self.canvas.pack()
        self.score_var = tk.StringVar(value="Score: 0")
        tk.Label(self.root, textvariable=self.score_var, font=("DejaVu Sans", 12)).pack()
        self.reset()
        self.root.bind("<KeyPress>", self.on_key)
        self.tick()
        self.root.mainloop()

    def reset(self):
        self.snake = [(COLS // 2, ROWS // 2)]
        self.direction = (1, 0)
        self.food = self.random_food()
        self.score = 0
        self.game_over = False
        self.score_var.set("Score: 0")

    def random_food(self):
        while True:
            pos = (random.randint(0, COLS - 1), random.randint(0, ROWS - 1))
            if pos not in self.snake:
                return pos

    def on_key(self, event):
        key = event.keysym
        mapping = {
            "Up": (0, -1), "Down": (0, 1),
            "Left": (-1, 0), "Right": (1, 0),
            "w": (0, -1), "s": (0, 1),
            "a": (-1, 0), "d": (1, 0),
        }
        if key in mapping:
            new_dir = mapping[key]
            # Prevent reversing into self
            if (new_dir[0] * -1, new_dir[1] * -1) != self.direction:
                self.direction = new_dir
        elif key in ("r", "R") and self.game_over:
            self.reset()

    def tick(self):
        if not self.game_over:
            head = self.snake[0]
            new_head = (head[0] + self.direction[0], head[1] + self.direction[1])
            # Wrap around
            new_head = (new_head[0] % COLS, new_head[1] % ROWS)
            if new_head in self.snake:
                self.game_over = True
                self.score_var.set(f"Game Over! Score: {self.score}  (R to restart)")
            else:
                self.snake.insert(0, new_head)
                if new_head == self.food:
                    self.score += 10
                    self.score_var.set(f"Score: {self.score}")
                    self.food = self.random_food()
                else:
                    self.snake.pop()
        self.draw()
        self.root.after(SPEED, self.tick)

    def draw(self):
        self.canvas.delete("all")
        # Food
        fx, fy = self.food
        self.canvas.create_rectangle(fx*CELL, fy*CELL, (fx+1)*CELL, (fy+1)*CELL, fill="#f38ba8", outline="")
        # Snake
        for i, (x, y) in enumerate(self.snake):
            color = "#89b4fa" if i == 0 else "#74c7ec"
            self.canvas.create_rectangle(x*CELL, y*CELL, (x+1)*CELL, (y+1)*CELL, fill=color, outline="#1e1e2e")

if __name__ == "__main__":
    SnakeGame()
